# Buat database gratis di https://console.upstash.com (Redis > Create Database)
# lalu salin dua nilai ini dari tab "REST API".
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# PIN bebas buat kunci halaman /admin.html (rekap harian). Ini bukan auth
# sungguhan, cuma penghalang ringan — lihat catatan di api/_lib/adminAuth.js.
ADMIN_PIN=
